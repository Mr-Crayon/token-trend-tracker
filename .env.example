# Neon (added automatically if you connect Neon through Vercel's Storage tab)
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Free Demo key from https://www.coingecko.com/en/developers/dashboard
COINGECKO_DEMO_API_KEY=""

# Any long random string, e.g. `openssl rand -hex 32`. Same value goes in the GitHub repo secret.
CRON_SECRET=""

# From https://app.arcjet.com. Leave empty in local dev to skip protection.
ARCJET_KEY=""
